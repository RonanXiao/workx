// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`shows the preselected project name and lists every project in the menu > open project picker 1`] = `"<div class="shrink-0 px-6 pb-4"><form class="relative mx-auto w-full max-w-[42rem] rounded-3xl border border-line bg-composer shadow-[var(--elevation-composer)] transition-colors focus-within:border-line-strong"><div class="flex items-center px-3 pt-3"><div class="relative"><button type="button" class="flex h-7 items-center gap-1.5 rounded-md border border-line px-2 text-[13px] text-fg-secondary hover:bg-hover disabled:opacity-60"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder size-3.5 shrink-0" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><span class="max-w-[220px] truncate">Alpha project</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="fixed inset-0 z-40"></div><div class="absolute z-50 max-h-[min(60vh,380px)] min-w-[280px] overflow-y-auto overscroll-contain rounded-xl border border-line bg-elevated p-1 shadow-xl bottom-full mb-2 left-0"><button type="button" class="flex w-full items-start gap-2 rounded-lg px-2.5 py-2 text-left hover:bg-hover"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 size-3.5 shrink-0 opacity-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="min-w-0 flex-1"><span class="block truncate text-[13px]">No project</span></span></button><button type="button" class="flex w-full items-start gap-2 rounded-lg px-2.5 py-2 text-left hover:bg-hover"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 size-3.5 shrink-0 opacity-100" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="min-w-0 flex-1"><span class="block truncate text-[13px]">Alpha project</span><span class="mt-0.5 block text-[12px] leading-snug text-fg-tertiary">/tmp/alpha</span></span></button><button type="button" class="flex w-full items-start gap-2 rounded-lg px-2.5 py-2 text-left hover:bg-hover"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check mt-0.5 size-3.5 shrink-0 opacity-0" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="min-w-0 flex-1"><span class="block truncate text-[13px]">Beta project</span><span class="mt-0.5 block text-[12px] leading-snug text-fg-tertiary">/tmp/beta</span></span></button></div></div></div><textarea rows="1" placeholder="Do anything" class="max-h-[240px] w-full resize-none bg-transparent px-4 pt-3.5 text-[16px] leading-[1.5] outline-none placeholder:text-fg-tertiary disabled:opacity-60" style="height: 0px;"></textarea><div class="flex items-center gap-1 px-3 pb-2.5 pt-0.5"><button type="button" class="no-drag inline-flex shrink-0 items-center justify-center rounded-md text-fg-secondary transition-colors hover:bg-hover hover:text-fg disabled:pointer-events-none disabled:opacity-40 size-7" aria-label="Add files and more" title="Add files and more (@)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-4" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg></button><div class="relative"><button type="button" class="flex h-7 items-center gap-1.5 rounded-md px-1.5 text-[13px] hover:bg-hover text-fg-secondary">Read only</button></div><div class="ml-auto flex items-center gap-1"><div class="relative"><button type="button" class="flex h-7 items-center gap-1 rounded-md px-2 text-[13px] text-fg-secondary hover:bg-hover disabled:opacity-60"><span class="max-w-[180px] truncate">Model</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div><button type="button" class="no-drag inline-flex shrink-0 items-center justify-center rounded-md text-fg-secondary transition-colors hover:bg-hover hover:text-fg disabled:pointer-events-none disabled:opacity-40 size-7" aria-label="Dictate"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mic size-4" aria-hidden="true"><path d="M12 19v3"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><rect x="9" y="2" width="6" height="13" rx="3"></rect></svg></button><button type="submit" aria-label="Send" disabled="" class="flex size-8 items-center justify-center rounded-full bg-send text-send-fg transition-opacity disabled:opacity-30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up size-4" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div></div></form></div>"`;

exports[`shows the project picker above the composer for a new chat > new chat project picker 1`] = `"<div class="shrink-0 px-6 pb-4"><form class="relative mx-auto w-full max-w-[42rem] rounded-3xl border border-line bg-composer shadow-[var(--elevation-composer)] transition-colors focus-within:border-line-strong"><div class="flex items-center px-3 pt-3"><div class="relative"><button type="button" class="flex h-7 items-center gap-1.5 rounded-md border border-line px-2 text-[13px] text-fg-secondary hover:bg-hover disabled:opacity-60"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder size-3.5 shrink-0" aria-hidden="true"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg><span class="max-w-[220px] truncate">Select project</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-3.5 shrink-0" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></div></div><textarea rows="1" placeholder="Do anything" class="max-h-[240px] w-full resize-none bg-transparent px-4 pt-3.5 text-[16px] leading-[1.5] outline-none placeholder:text-fg-tertiary disabled:opacity-60" style="height: 0px;"></textarea><div class="flex items-center gap-1 px-3 pb-2.5 pt-0.5"><button type="button" class="no-drag inline-flex shrink-0 items-center justify-center rounded-md text-fg-secondary transition-colors hover:bg-hover hover:text-fg disabled:pointer-events-none disabled:opacity-40 size-7" aria-label="Add files and more" title="Add files and more (@)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width